// ─── AI Analysis ──────────────────────────────────────────────────────────────

model AiAnalysis {
  id                   String   @id @default(cuid())
  jobId                String
  issueId              String
  /// 'alt-text' | 'alt-text-improve' | 'table-summary' | 'table-headers' | 'table-layout'
  /// | 'list-classify' | 'reading-order' | 'heading' | 'language'
  /// | 'color-contrast' | 'color-contrast-fix' | 'link-text' | 'form-field' | 'bookmark'
  suggestionType       String
  /// The fix value to write into the PDF (alt text string, summary, lang code, etc.)
  value                String?  @db.Text
  /// Long-form alt text (a fuller description than `value`'s short alt
  /// string), from the standalone Alt-Text Generator's `extendedAlt` output.
  /// Only ever populated on a `requiresManualReview` alt-text suggestion
  /// where the PDF pipeline's own fixer declined to produce anything --
  /// a drafting aid for the operator to copy into Acrobat Pro, never a
  /// value this service applies itself. Null for every other suggestion
  /// type and for rows that predate this column.
  extendedAlt          String?  @db.Text
  /// Human-readable instruction shown when the fix cannot be applied automatically
  guidance             String?  @db.Text
  confidence           Float
  rationale            String   @db.Text
  /// 'gemini-flash' | 'claude-haiku'
  model                String
  /// 'apply-to-pdf' | 'guidance-only' | 'auto-resolve'
  applyMode            String
  /// 'pending' | 'approved' | 'rejected' | 'applied' | 'failed' -- 'failed' is
  /// terminal, set once applyApprovedSuggestions has failed to apply this
  /// suggestion MAX_APPLY_ATTEMPTS times (see ai-analysis.service.ts). Without
  /// this, a suggestion whose fix handler fails for a structural reason that
  /// never changes (e.g. the PDF genuinely has no Figure element for this
  /// image) stayed 'approved' forever and got silently re-approved and
  /// re-attempted every single auto-mode round, burning that round's AI
  /// analysis cost on a guaranteed repeat failure -- confirmed live on
  /// Math_Olszewski_PDF.pdf (2026-10-20): the same ~190 suggestion IDs failed
  /// with the identical error message in all 3 rounds.
  status               String   @default("pending")
  /// Incremented each time applyApprovedSuggestions fails to apply this row;
  /// reset to 0 whenever resolveSuggestionStatus detects the underlying
  /// finding actually changed (new issueFingerprint/suggestionType/value),
  /// since that's a genuinely different attempt at a different thing.
  failedAttempts       Int      @default(0)
  /// The most recent apply-failure reason text (same string recordApplyFailure
  /// already logs and pushes into a cycle event's capped applyErrorsJson) --
  /// gives per-issue failure reasons a durable home outside that 50-entry cap,
  /// so the Apply Failure Report aggregation can group a job's full set of
  /// failures by (suggestionType, reason) instead of only the last cycle's
  /// first 50. Null for rows that have never failed, or predate this column.
  lastErrorReason      String?  @db.Text
  requiresManualReview Boolean  @default(false)
  /// 'operator' | 'auto-mode' -- who/what set status to 'approved'. Null for
  /// rows never approved (still pending/rejected) or predating this column.
  approvedBy           String?
  /// Stable identity for the underlying finding (code + element/page, or
  /// code + rounded position for contrast issues) -- independent of issueId,
  /// which is a per-audit sequential counter that gets reassigned whenever
  /// applyAll's internal re-audit replaces the audit report. Nullable:
  /// existing rows predate this column and simply won't match on their next
  /// re-analysis (identical to the prior unconditional-reset behavior -- not
  /// a regression), then self-heal once repopulated.
  issueFingerprint     String?
  /// Set only at the exact moment `status` transitions to 'applied' (the two
  /// write sites: the single-apply controller and applyApprovedSuggestions'
  /// own bulk/auto-loop path) -- never touched by the dispatch loop's own
  /// preserve-on-unchanged upsert, so it reliably marks "when did this row's
  /// CURRENT applied claim actually happen", unlike `updatedAt` (which every
  /// re-analysis bumps regardless of whether status changed). Nulled back out
  /// by revertUnpersistedApplies when a re-audit fails to persist the apply
  /// (status reverts to 'approved'), and overwritten fresh on every re-apply.
  /// Compared against the current audit report's own `auditedAt` to decide
  /// `appliedButUnresolved` below -- see resolveSuggestionStatus's own doc
  /// comment for the exact rule.
  appliedAt            DateTime?
  /// True when a FRESH audit report (its own `auditedAt` later than this
  /// row's `appliedAt`) still detects the identical finding (same
  /// issueFingerprint/suggestionType/value) this row was already marked
  /// 'applied' for -- i.e. the fix didn't take effect, or didn't persist.
  /// Set instead of preserving 'applied' (status resets to the normal
  /// pending/approved default so existing status-based counts/filters
  /// everywhere else need no changes); IssueCard renders this as "Applied --
  /// still detected" rather than a plain fresh suggestion. Excluded from
  /// auto-remediation-loop's own automatic apply/actionable-count (human
  /// Apply only, to avoid an infinite re-apply loop on something already
  /// proven not to work) and surfaced in the Apply Failure Report. Cleared
  /// only by a later audit confirming resolution (the row itself stops
  /// matching/gets pruned) or a human explicitly dismissing/rejecting the
  /// suggestion -- a bare re-apply alone does NOT clear it; only the next
  /// audit's own comparison can.
  appliedButUnresolved Boolean  @default(false)
  /// QC brief Theme B3 (docs/qc/2026-11-23-ninja-qc-karsaklian-brief.md):
  /// set the moment a human completes review of a `requiresManualReview`
  /// row -- rejecting it (accepts the gap), "Approve & apply long
  /// description" (writes the long description as the real /Alt), or
  /// "Keep short alt" (a deliberate "the auto-applied short alt is good
  /// enough" decision, distinct from both of those). NOT `status`: once
  /// draftComplexImageBaseline's short-alt baseline auto-applies,
  /// `status` becomes 'applied' immediately -- long before any human has
  /// reviewed the long description -- so `status` alone can't tell
  /// "resolved" apart from "just auto-applied a baseline". "Unresolved"
  /// everywhere (the Apply Failure Report bucket, the AI-analysis status
  /// endpoint's own count, Auto Mode's completion message) is
  /// `requiresManualReview: true AND manualReviewCompletedAt IS NULL`.
  /// Carried forward across re-analysis by resolveCarriedManualReviewCompletedAt,
  /// the same class of bug appliedButUnresolved's own carry-forward fix
  /// (PR #876) exists to prevent -- a fresh short-alt guess on a later
  /// analysis pass must never silently un-mark a completed review or
  /// overwrite a human-reviewed `value`.
  manualReviewCompletedAt DateTime?
  /// Every draftComplexImageBaseline candidate hasGroundedWordOverlap
  /// rejected for this issue -- APPENDED one entry per round it recurred
  /// in, never overwritten, so a human judging the guard's real false-
  /// reject rate can see every round's own rejected text, not just
  /// whichever round happened to run last (2026-11-27, see
  /// AiSuggestionResult.altTextGuardRejected's own doc comment in
  /// ai-analysis.service.ts for the full mechanism this feeds). Array of
  /// {alt, groundingText, rejectedAt}. Null when this issue was never
  /// routed through draftComplexImageBaseline, or never hit the guard.
  rejectedBaselineHistory Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([jobId, issueId])
  @@index([jobId])
}

