// ZONE MODEL (PDF Content Regions)
// ============================================================

model Zone {
  id             String    @id @default(uuid())
  tenantId       String
  fileId         String?
  file           File?     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  pageNumber     Int
  type           String // "TABLE" | "P" | "H1"-"H6" | "FIGURE" | "LIST" | "LI" | "ARTIFACT" etc
  label          String?
  readingOrder   Int?
  bounds         Json? // { x, y, width, height }
  content        String?   @db.Text
  altText        String?
  longDesc       String?   @db.Text
  tableStructure Json? // { rows: [{ cells: [{ type, content, colspan, rowspan, align }] }] }
  zoneSubtype    String? // "THEAD" | "TBODY" | null
  rowCount       Int?
  parentZoneId   String?
  parentZone     Zone?     @relation("ZoneChildren", fields: [parentZoneId], references: [id])
  childZones     Zone[]    @relation("ZoneChildren")
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // ML pipeline fields
  source               String? // 'docling' | 'pdfxt' | 'operator'
  reconciliationBucket String? // 'GREEN' | 'AMBER' | 'RED'
  doclingLabel         String?
  doclingConfidence    Float?
  pdfxtLabel           String?
  operatorVerified     Boolean   @default(false)
  operatorLabel        String?
  operatorBbox         Json?
  verifiedAt           DateTime?
  verifiedBy           String?
  isArtefact           Boolean   @default(false)
  isGhost              Boolean   @default(false) // Structure element found but no bbox computed
  ghostTag             String? // Original tag name for ghost zones (for debug/QA)
  correctionReason     String? // Free-text reason for correction/rejection
  decision             String? // 'CONFIRMED' | 'CORRECTED' | 'REJECTED' | null (unreviewed)

  // AI annotation fields
  aiLabel       String? // AI-predicted label (e.g. 'paragraph', 'list-item', 'h2')
  aiConfidence  Float? // AI confidence score 0-1
  aiDecision    String? // 'CONFIRMED' | 'CORRECTED' | 'REJECTED'
  aiReason      String?   @db.Text // AI reasoning for the decision
  aiModel       String? // Model used (e.g. 'gemini-2.0-flash', 'claude-sonnet-4')
  aiAnnotatedAt DateTime? // When AI annotation was applied

  // ML pipeline relations
  bootstrapJobId   String?
  calibrationRunId String?
  bootstrapJob     ZoneBootstrapJob? @relation(fields: [bootstrapJobId], references: [id])
  calibrationRun   CalibrationRun?   @relation(fields: [calibrationRunId], references: [id])

  @@unique([parentZoneId, zoneSubtype])
  @@index([fileId])
  @@index([tenantId])
  @@index([parentZoneId])
  @@index([bootstrapJobId])
  @@index([calibrationRunId])
  @@index([calibrationRunId, decision])
}

model AiAnnotationRun {
  id                  String    @id @default(cuid())
  calibrationRunId    String
  model               String // 'gemini-2.0-flash' | 'claude-sonnet-4'
  status              String    @default("RUNNING") // 'RUNNING' | 'COMPLETED' | 'FAILED'
  totalZones          Int       @default(0)
  annotatedZones      Int       @default(0)
  skippedZones        Int       @default(0)
  confirmedCount      Int       @default(0)
  correctedCount      Int       @default(0)
  rejectedCount       Int       @default(0)
  highConfCount       Int       @default(0) // >= 0.95
  medConfCount        Int       @default(0) // 0.80 - 0.95
  lowConfCount        Int       @default(0) // < 0.80
  inputTokens         Int       @default(0)
  outputTokens        Int       @default(0)
  estimatedCostUsd    Float     @default(0)
  promptVersion       String? // e.g. 'v1', 'v2' — tracks which prompt was used
  confidenceThreshold Float? // threshold used for this run
  dryRun              Boolean   @default(false)
  currentPage         Int?
  totalPages          Int?
  durationMs          Int?
  error               String?   @db.Text
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  calibrationRun CalibrationRun @relation(fields: [calibrationRunId], references: [id], onDelete: Cascade)

  @@index([calibrationRunId])
}

model AnnotationComparison {
  id                    String    @id @default(cuid())
  calibrationRunId      String
  status                String    @default("RUNNING") // 'RUNNING' | 'COMPLETED' | 'FAILED'
  totalZones            Int       @default(0)
  comparableZones       Int       @default(0) // zones with both human + AI decisions
  agreementCount        Int       @default(0)
  disagreementCount     Int       @default(0)
  agreementRate         Float     @default(0) // 0-1
  cohensKappa           Float? // -1 to 1
  perTypeAccuracy       Json? // { "paragraph": 0.95, "h1": 0.80, ... }
  perBucketAccuracy     Json? // { "GREEN": 0.98, "AMBER": 0.75, "RED": 0.60 }
  confidenceCalibration Json? // [{ bucket: "0.90-0.95", predicted: 0.925, actual: 0.91, count: 40 }, ...]
  commonMistakes        Json? // [{ from: "paragraph", to: "list-item", count: 12 }, ...]
  zoneDetails           Json? // full zone-level comparison array
  durationMs            Int?
  error                 String?   @db.Text
  createdAt             DateTime  @default(now())
  completedAt           DateTime?

  calibrationRun CalibrationRun @relation(fields: [calibrationRunId], references: [id], onDelete: Cascade)

  @@index([calibrationRunId])
}

// ============================================================
// ML ZONE DETECTION PIPELINE
// ============================================================

model ZoneBootstrapJob {
  id             String         @id @default(cuid())
  documentId     String
  status         String         @default("PENDING") // PENDING | RUNNING | COMPLETE | FAILED
  extractionMode String? // 'docling' | 'pdfxt' | null (not yet run)
  startedAt      DateTime?
  completedAt    DateTime?
  failureReason  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  zones          Zone[]
  corpusDocument CorpusDocument @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@index([status])
}

model CorpusDocument {
  id              String             @id @default(cuid())
  filename        String
  s3Path          String
  publisher       String?
  contentType     String? // 'text-dominant' | 'table-heavy' | 'figure-heavy' | 'mixed'
  pageCount       Int?
  language        String             @default("en")
  isScanned       Boolean            @default(false)
  trainingSplit   String? // "train" | "val" | "test" | null
  taggedPdfPath   String? // S3 path to operator-uploaded pdfxt-tagged PDF
  uploadedAt      DateTime           @default(now())
  // Status Tracker — operator-editable per-document state. Override values come from
  // the AnnotationStatus union (NOT_STARTED|IN_PROGRESS|PENDING_REVIEW|COMPLETED|BLOCKED);
  // when null, the row's status is derived from pagesAnnotated vs pageCount.
  statusNote      String?            @db.Text
  statusOverride  String?
  statusUpdatedAt DateTime?
  statusUpdatedBy String?
  bootstrapJobs   ZoneBootstrapJob[]
  calibrationRuns CalibrationRun[]
}

model CalibrationRun {
  id                    String                 @id @default(cuid())
  documentId            String
  runDate               DateTime               @default(now())
  completedAt           DateTime?
  durationMs            Int?
  doclingZoneCount      Int?
  pdfxtZoneCount        Int?
  greenCount            Int?
  amberCount            Int?
  redCount              Int?
  summary               Json?
  mapSnapshot           Json?
  isArchived            Boolean                @default(false)
  type                  String                 @default("CALIBRATION") // 'CALIBRATION' | 'PIKE_PDF_SPIKE'
  pagesReviewed         Int?
  completionNotes       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  zones                 Zone[]
  annotationSessions    AnnotationSession[]
  aiAnnotationRuns      AiAnnotationRun[]
  annotationComparisons AnnotationComparison[]
  issues                CalibrationRunIssue[]
  emptyPageReviews      EmptyPageReview[]
  corpusDocument        CorpusDocument         @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@index([completedAt])
}

model CalibrationRunIssue {
  id            String           @id @default(uuid())
  runId         String
  run           CalibrationRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  category      RunIssueCategory
  pagesAffected Int?
  description   String
  blocking      Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([runId])
  @@index([category])
}

enum RunIssueCategory {
  PAGE_ALIGNMENT_MISMATCH
  INSUFFICIENT_JOINT_COVERAGE
  LIMITED_ZONE_COVERAGE
  UNEQUAL_EXTRACTOR_COVERAGE
  SINGLE_EXTRACTOR_ONLY
  ZONE_CONTENT_DIVERGENCE
  COMPLETED_WITH_REDUCED_SCOPE
  OTHER
}

enum EmptyPageCategory {
  LEGIT_EMPTY
  DETECTION_FAILURE
  UNSURE
}

model EmptyPageReview {
  id               String            @id @default(uuid())
  calibrationRunId String
  calibrationRun   CalibrationRun    @relation(fields: [calibrationRunId], references: [id], onDelete: Cascade)
  pageNumber       Int
  category         EmptyPageCategory
  pageType         String
  expectedContent  String?           @db.Text
  notes            String?           @db.Text
  annotatorId      String
  annotator        User              @relation(fields: [annotatorId], references: [id])
  reviewedAt       DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdAt        DateTime          @default(now())

  @@unique([calibrationRunId, pageNumber])
  @@index([calibrationRunId])
  @@index([annotatorId])
}

model AnnotationSession {
  id               String         @id @default(cuid())
  calibrationRunId String
  calibrationRun   CalibrationRun @relation(fields: [calibrationRunId], references: [id])
  operatorId       String
  pageNumber       Int?
  startedAt        DateTime
  endedAt          DateTime?
  activeMs         Int            @default(0)
  idleMs           Int            @default(0)
  zonesReviewed    Int            @default(0)
  zonesConfirmed   Int            @default(0)
  zonesCorrected   Int            @default(0)
  zonesRejected    Int            @default(0)
  annotationMode   String? // 'blind' | 'ai-assisted' | 'ai-review-only'
  sessionLog       Json? // SessionSegment[] from client timer
  createdAt        DateTime       @default(now())

  @@index([calibrationRunId])
  @@index([operatorId])
  @@index([calibrationRunId, operatorId])
}

/// One row per source document in the pdfxt-vs-Ninja validation study.
/// Deliberately has no relation to CorpusDocument or anything in the
/// training pipeline — these are fresh documents the model has never
/// seen, and keeping the table structurally separate is what makes
/// that a guarantee rather than a policy.
model ComparisonTrial {
  id             String @id @default(cuid())
  sourceFileName String
  sourceS3Path   String
  contentType    String // 'text-dominant' | 'table-heavy' | 'figure-heavy' | 'mixed'
  operatorId     String

  ninjaJobId        String? @unique
  job               Job?    @relation(fields: [ninjaJobId], references: [id])
  ninjaActiveMs     Int?
  /// Self-reported time (ms) spent on manual out-of-app remediation (e.g.
  /// Acrobat Pro) for guidance-only items Ninja can't auto-fix -- invisible
  /// to ninjaActiveMs, which only tracks time active on Ninja's own pages.
  /// Accumulated via POST /pdf/:jobId/manual-remediation-time.
  ninjaManualTimeMs Int?    @default(0)
  ninjaGpuCostUsd   Float?
  ninjaPacResult    Json?

  pdfxtS3Path    String?
  pdfxtTimeMs    Int?
  pdfxtPageCount Int?
  pdfxtCostUsd   Float?
  pdfxtPacResult Json?

  /// 'manual' (operator drives every round) | 'auto' (backend loops
  /// analyze->approve->apply->reaudit on its own until convergence or a
  /// limit, default -- registerTrial relies on this default rather than
  /// setting it explicitly, so a new trial starts in auto mode without any
  /// manual Save).
  mode                  String    @default("auto")
  autoMaxRounds         Int       @default(10)
  autoCostLimitUsd      Float     @default(2.0)
  autoRoundsCompleted   Int       @default(0)
  /// Cumulative Gemini cost across all rounds of the current/last auto run --
  /// Job.output.aiAnalysisStats is overwritten per analysis round, not
  /// cumulative, so the running total has to live here instead.
  autoCostSpentUsd      Float     @default(0)
  /// 'running' | 'stopped'; null if auto mode has never been started.
  autoStatus            String?
  /// 'converged' | 'round_limit' | 'budget_limit' | 'manual_stop' | 'stalled' | 'error'
  autoStopReason        String?
  /// Wall-clock start/stop of the current/last auto-mode run, for a real
  /// "time to convergence" figure. Both written by startAutoLoop() (start
  /// alongside the existing autoStatus:'running' reset, stop in its
  /// finally block alongside the existing terminal-state write) and
  /// autoStoppedAt is also written by reconcileIfOrphaned() -- without
  /// that, a crashed/orphan-reconciled run would have no stop timestamp
  /// at all.
  autoStartedAt         DateTime?
  autoStoppedAt         DateTime?
  /// Cooperative cancellation flag -- checked at the top of each round, never
  /// mid-round, so a stop request never leaves a round half-applied.
  autoStopRequested     Boolean   @default(false)
  /// 'guidance-only' | 'disabled' | 'apply-to-pdf', or null to inherit the
  /// tenant's own aiRemediation.colorContrastMode setting (or the backend
  /// default if the tenant hasn't set one either) -- exactly what auto mode
  /// did before this column existed. Must stay nullable with NO SCHEMA
  /// default: Tenant.settings.aiRemediation.colorContrastMode is a real,
  /// operator-configurable setting (tenant-config.controller.ts), and a
  /// non-null default at this column level would unconditionally override
  /// it for every trial, even ones nobody explicitly configured -- there'd
  /// be no way to tell "operator wants the tenant default" from "operator
  /// wants apply-to-pdf" once both look the same (non-null) at write time.
  /// registerTrial sets this explicitly to 'apply-to-pdf' for every NEW
  /// trial it creates instead -- an intentional, comparison-study-specific
  /// application default, not a schema-level one, so it doesn't touch the
  /// tenant-wide default other flows still inherit and stays overridable
  /// (including back to null/inherit) by an operator editing the trial
  /// afterward. Read fresh each round like autoMaxRounds/autoCostLimitUsd,
  /// so it can be changed (or cleared back to null) mid-run and takes
  /// effect starting the next round.
  autoColorContrastMode String?

  status    String   @default("registered") // registered -> ninja_complete -> pdfxt_logged -> validated -> reported
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  externalPacReport ExternalPacReport?

  @@index([operatorId])
  @@index([status])
  @@index([contentType])
}

/// A real, external PAC-tool report file uploaded by an operator against a
/// trial's final remediated output -- distinct from BOTH of this codebase's
/// other two "PAC report" concepts: pac-report.service.ts's own
/// self-generated Matterhorn-protocol emulation, and
/// ComparisonTrial.ninjaPacResult/pdfxtPacResult (a veraPDF failure-count
/// blob). Nothing parses real PAC export files (HTML/XML/PDF) today, so the
/// summary counts below are entered manually by the uploading operator,
/// same as pdfxtTimeMs/pdfxtCostUsd/etc. are today -- not derived from the
/// file's own contents.
model ExternalPacReport {
  id               String          @id @default(cuid())
  trialId          String          @unique
  trial            ComparisonTrial @relation(fields: [trialId], references: [id], onDelete: Cascade)
  s3Key            String
  originalFileName String
  mimeType         String
  size             Int
  pass             Int?
  fail             Int?
  untested         Int?
  humanRequired    Int?
  notApplicable    Int?
  uploadedById     String
  createdAt        DateTime        @default(now())
}

/// Job-native counterpart to ExternalPacReport above -- same real, external
/// PAC-tool report upload capability, but for a regular PDF Accessibility
/// job (single-file upload or a PdfBatchItem's job) that has no linked
/// ComparisonTrial. Deliberately a separate model rather than making
/// ExternalPacReport.trialId optional-plus-jobId: keeps Comparison Study's
/// existing code/data untouched and this feature's blast radius isolated.
model JobExternalPacReport {
  id               String   @id @default(cuid())
  jobId            String   @unique
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  s3Key            String
  originalFileName String
  mimeType         String
  size             Int
  pass             Int?
  fail             Int?
  untested         Int?
  humanRequired    Int?
  notApplicable    Int?
  uploadedById     String
  createdAt        DateTime @default(now())
  // createdAt never moves on a re-upload (confirm is an upsert); updatedAt
  // is when the current report file was confirmed.
  updatedAt        DateTime @default(now()) @updatedAt
  // sha256 of the job's remediated PDF at the moment this report was
  // confirmed -- binds the report to the exact bytes it was run on, so the
  // EPUB certification gate can reject a report for an older file. Null
  // when the job had no remediated file yet (such a report can never
  // satisfy the gate).
  remediatedSha256 String?

  @@index([jobId])
}

/// An Acrobat Pro Accessibility Checker HTML report an operator uploaded
/// against a PDF job -- evidence for the EPUB-from-certified-PDF
/// certification gate, alongside JobExternalPacReport. Same presign/confirm
/// flow and job-storage/<jobId>/... key prefix (swept by deleteJobFiles).
/// Counts come from the server-side parser (acrobat-report-parser.ts) when
/// it can read the report unambiguously, otherwise from the operator
/// (countsSource says which).
model JobExternalAcrobatReport {
  id               String   @id @default(cuid())
  jobId            String   @unique
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  s3Key            String
  originalFileName String
  mimeType         String
  size             Int
  passed           Int?
  failed           Int?
  needsManualCheck Int?
  skipped          Int?
  passedManually   Int?
  failedManually   Int?
  // 'parsed' | 'operator'
  countsSource     String
  // [{ category, rule, ruleId, status, description }] for every Failed /
  // Failed manually rule the parser found (empty when it couldn't read the
  // rule table).
  failedRules      Json?
  parseWarnings    Json?
  // Same meaning as JobExternalPacReport.remediatedSha256.
  remediatedSha256 String?
  uploadedById     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([jobId])
}

/// Certification that a PDF job's remediated file is accessible enough to
/// build an EPUB from (EPUB-from-certified-PDF gate). At most one ACTIVE
/// (revokedAt null) row per job; history is kept by revoking, never
/// deleting. Pinned to the exact remediated bytes (pdfSha256) and to the
/// exact evidence report uploads (s3Key + updatedAt of each report row --
/// confirm is an upsert, so a row's id survives a replacement and can't
/// detect one). Any change to either revokes it. Records who certified;
/// stays valid if teams change later (only new actions check the team).
model JobCertification {
  id                      String    @id @default(cuid())
  jobId                   String
  job                     Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  pdfSha256               String
  remediatedFileRef       String
  certifiedById           String
  certifiedAt             DateTime  @default(now())
  // Operator attestations (Acrobat Pro checks); all required true.
  allAcrobatChecksRun          Boolean
  altTextReviewedEveryFigure   Boolean
  readingOrderSpotChecked      Boolean
  bookmarksAndTitleChecked     Boolean
  // Acrobat report (must show Skipped = 0)
  acrobatNotes            String?
  acrobatReportId         String
  acrobatReportS3Key      String
  acrobatReportUpdatedAt  DateTime
  acrobatFailed           Int
  // [{ ruleKey, ruleId, category, rule, reason, waivedById, waivedAt }],
  // one per Failed / Failed manually rule.
  acrobatWaivers          Json
  // PAC evidence: uploaded report (required) + operator attestation
  pacReportId             String
  pacReportS3Key          String
  pacReportUpdatedAt      DateTime
  pacFail                 Int
  // Operator-attested PDF/UA error count; must be 0.
  pacPdfUaErrorsAttested  Int
  // [{ check, count, reason, waivedById, waivedAt }], one per failed PAC
  // check (WCAG side; PDF/UA errors must be 0). PAC's fail counts
  // occurrences, so the waived counts must sum to pacFail.
  pacWaivers              Json
  revokedAt               DateTime?
  revokedById             String?
  // 'manual: <text>' | 'pdf-changed' | 'acrobat-report-replaced' |
  // 'acrobat-report-deleted' | 'pac-report-replaced' | 'pac-report-deleted'
  revokedReason           String?

  @@index([jobId])
  @@index([jobId, revokedAt])
}

/// Ninja-side remediation timing for a ComparisonTrial's job. Structural
/// twin of AnnotationSession (same idle/visibility-aware activeMs/idleMs
/// accumulation via the client timer), keyed on jobId instead of
/// calibrationRunId since remediation isn't tied to a CalibrationRun.
model RemediationSession {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  operatorId String
  startedAt  DateTime
  endedAt    DateTime?
  activeMs   Int       @default(0)
  idleMs     Int       @default(0)

  issuesApplied       Int     @default(0)
  suggestionsAccepted Int     @default(0)
  suggestionsRejected Int     @default(0)
  bulkApplyUsed       Boolean @default(false)

  sessionLog Json? // SessionSegment[] from client timer
  createdAt  DateTime @default(now())

  @@index([jobId])
  @@index([operatorId])
}

/// Append-only history log of every completed (or failed) remediation-cycle
/// action -- apply-fixes, re-audit, or AI re-analysis -- keyed by
/// cycleNumber so the guided-remediation checklist can group entries into
/// "Run 1 / Run 2 / ..." (see GET /pdf/:jobId/remediation/history). One row
/// per action; multiple actions can share a cycleNumber when they happened
/// under the same remediation-cycle lock hold (e.g. apply-all's own
/// automatic re-audit shares its caller's cycleNumber). Unlike
/// RemediationChange's changeNumber, cycleNumber is deliberately NOT unique
/// per row here -- several actions legitimately share one cycle.
model RemediationCycleEvent {
  id                      String   @id @default(uuid())
  jobId                   String
  job                     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cycleNumber             Int
  action                  String // 'apply_fixes' | 'reaudit' | 'ai_analysis'
  source                  String // 'apply_all' | 'reaudit_pdf_upload' | 'reaudit_current_file' | 'analyze_job'
  status                  String // 'completed' | 'failed'
  appliedCount            Int?
  failedCount             Int?
  resolvedCount           Int?
  remainingCount          Int?
  regressionCount         Int?
  resolutionRate          Float?
  errorMessage            String?
  triggeredBy             String?
  startedAt               DateTime
  completedAt             DateTime @default(now())
  /// This round's AI spend (Operational Reports Group 2 -- see
  /// OPERATIONAL_REPORTS_DESIGN.md). Only ever populated on the 'ai_analysis'
  /// action -- that's the one action every round logs regardless of whether
  /// apply/reaudit ran, and the only point in the loop where AI cost is
  /// actually incurred. Nullable/additive -- old rows simply have no cost
  /// data, not zero.
  costUsd                 Float?
  /// Per-suggestion-type { applied, failed } counts for this apply_fixes
  /// event (Operational Reports Group 3 -- see OPERATIONAL_REPORTS_DESIGN.md).
  /// Derived in ai-analysis.service.ts's applyApprovedSuggestions purely from
  /// data it already computes (the approved list + the errors array) --
  /// does not change any apply logic. Only ever populated on 'apply_fixes'.
  suggestionTypeBreakdown Json?
  /// Capped failure detail ({ errors: [...], totalErrors, truncated }) for
  /// this apply_fixes event -- the per-suggestion-type reason detail that
  /// was previously computed and then discarded. Capped at 50 entries so a
  /// round with thousands of failures doesn't blow up the row; totalErrors
  /// preserves the real count even when the list itself is cut. Only ever
  /// populated on 'apply_fixes', and only when there were failures.
  applyErrorsJson         Json?
  /// Per-issue-code counts ({ "CODE": count, ... }) for this reaudit
  /// event's resolved/regressions arrays -- the breakdown behind
  /// resolvedCount/regressionCount, previously only ever visible in a log
  /// line (pdf-reaudit.service.ts's "Regressions this round: ..."), never
  /// persisted or surfaced in the UI. Naturally bounded by the number of
  /// distinct validator codes in this codebase (well under 100), not by
  /// issue count, so no truncation cap is needed the way applyErrorsJson
  /// needs one. Only ever populated on 'reaudit'.
  resolvedByCode          Json?
  regressionsByCode       Json?

  @@index([jobId, cycleNumber])
}

model TrainingRun {
  id                      String    @id @default(cuid())
  corpusExportS3Path      String
  modelVariant            String    @default("yolov8m")
  status                  String    @default("PENDING")
  mapResult               Json?
  evaluationResult        Json?
  promotionRecommendation String?
  weightsS3Path           String?
  onnxS3Path              String?
  corpusSnapshot          Json?
  corpusSize              Int?
  epochs                  Int?
  durationMs              Int?
  triggerType             String    @default("MANUAL")
  publisherId             String?
  promotedAt              DateTime?
  promotedBy              String?
  startedAt               DateTime  @default(now())
  completedAt             DateTime?

  @@index([status])
  @@index([completedAt])
}

/// Caches a YOLO zone-detector result (seam-c-tag.service.ts) so the exact
/// same source PDF, detected with the exact same model/weights/params,
/// returns the exact same zones on a later run -- without ever calling the
/// GPU service again. Real bug this closes (2026-11-26, see git log): T4 (a
/// QC regression corpus title with no struct tree, so every Figure comes
/// from a fresh YOLO pass every run) produced a different Figure count
/// across two full-pipeline runs of the identical commit on the identical
/// file -- GPU inference has no determinism guarantee by default. The
/// zone-detector service itself now pins cuDNN to deterministic mode (see
/// zone-detector-service/main.py), but this cache is a second, independent
/// layer: even a residual GPU-driver/library-level difference can never
/// surface as a different real-world result once a cache row exists for
/// this exact (source, model, params) combination, and it saves the real
/// GPU cost of re-detecting an already-seen document.
///
/// cacheKey is a single sha256 of every input that should distinguish one
/// detection from another (source PDF bytes, the weights S3 URI + its own
/// ETag, a deploy-time ZONE_DETECTOR_VERSION env var, and the detection
/// params RENDER_DPI/MAX_EDGE/IMGSZ/CONF) -- see
/// zone-detection-cache.service.ts's own computeCacheKey for the exact
/// composition. reportedWeightsSha256 is the SAFETY NET: the live
/// detection response (zone-detector-service's own /detect, PR #894) always
/// reports the weights hash it actually used, so a later detection whose
/// reported hash disagrees with an existing row's for the same source PDF
/// means the SSM-URI+ETag proxy failed to distinguish two real model
/// versions -- logged as an error, never silently trusted.
///
/// Tenant-scoped (never a global/shared cache) so a cache row is
/// deletable per-tenant for a data-retention request, same as every other
/// tenant-owned table in this schema.
model ZoneDetectionCache {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cacheKey              String
  sourcePdfSha256        String
  weightsUri             String
  weightsETag            String
  zoneDetectorVersion    String
  /// From the live response's own modelInfo.weightsSha256 (PR #894) --
  /// nullable since an older/degraded service response might not carry it.
  reportedWeightsSha256  String?
  /// The full YoloServiceResponse['zones'] array, unmodified.
  zones                  Json
  createdAt              DateTime @default(now())

  @@unique([tenantId, cacheKey])
  @@index([tenantId, sourcePdfSha256])
}
