# Local Terraform working directories and state -- real state lives only in
# the S3 backend (see bootstrap/README.md), never committed.
.terraform/
*.tfstate
*.tfstate.*

# Real variable values (secrets, account-specific overrides) -- commit only
# the *.tfvars.example files alongside each environment.
*.tfvars
!*.tfvars.example

# Terraform crash logs
crash.log
crash.*.log

# Override files are a local-only escape hatch, never meant to be committed
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
