{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ZoneDetectionCacheReadWeightsIdentity",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-south-1:223643972423:parameter/ninja/zone-extractor/model-weights-path"
    },
    {
      "Sid": "ZoneDetectionCacheReadWeightsEtag",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<WEIGHTS_BUCKET_NAME>/*"
    }
  ]
}
